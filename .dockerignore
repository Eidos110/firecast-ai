# =============================================================================
# Docker Ignore
# Applied before Railway build context is captured.
# Keeps only files needed for the Dockerfile build.
#
# Verified: every COPYed/used path below is NOT matched by any rule here.
# React stage (stage 0) uses: frontend_react/package.json, package-lock.json,
#   vite.config.ts, tsconfig*.json, src/, build/ — all kept.
# Pip installs use: requirements*.txt — all kept.
# COPY . . stages need: all src/, frontend/, models/, data/ (kept).
# =============================================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class

# ── Node dependencies (reinstalled by npm ci in Docker) ──
node_modules/
frontend_react/node_modules/

# ── Test / dev caches ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.hypothesis/
htmlcov/
.coverage

# ── IDE / editor ──
.vscode/
.idea/

# ── OS / system files ──
.DS_Store
Thumbs.db

# ── Temporary / scratch ──
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.tmp/

# ── Jupyter checkpoints ──
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ── Python build / packaging ──
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg

# ── Virtual environments ──
venv/
ENV/
env/
.venv

# ── Logs ──
logs/
*.log

# ── Secrets (Railway injects via env vars) ──
.env
.env.local
.env.*.local
.env.production

# ── Secrets & VCS — MUST never enter any image layer (audit 2026-08-23:
#    previously only .env* was excluded, so secrets/firecast-*.json and the
#    entire .git/ history rode into local `docker build` layers via COPY . .) ──
secrets/
.git/
.gitattributes
.gitignore
*.zcode-session
**/*service*account*.json
**/firecast-*.json

# ── Local artefacts that are rebuilt in-image or shadow fresh data ──
# Parquet twins are a local data cache; the tracked CSV is the source of
# truth (regen via scripts/migrate_to_parquet.py when needed).
data/*.parquet
# The SPA is compiled fresh in stage 0 (spa-build); a stale local build must
# not leak into the final image.
frontend_react/build/

# ── Output / results ──
output/
results/
*.png
*.jpg
*.pdf
