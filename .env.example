# FireCast Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# =============================================================================

# API KEYS - Weather & Geocoding
# =============================================================================

# OpenWeatherMap API Key (get from: https://openweathermap.org/api)
# Without this key, the system will use demo/backup weather data
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google Maps API Key (optional, for geocoding fallback)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Earth Engine service-account credentials path (JSON key file)
# Store the key under ./secrets/ and never commit it. Example:
#   GOOGLE_APPLICATION_CREDENTIALS=./secrets/your-gee-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Application Settings
# =============================================================================

# Application Environment: development, staging, production
APP_ENV=development

# Debug Mode: true or false
DEBUG=true

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Model Settings
# =============================================================================

# Device for ML models: auto, cpu, cuda
ML_DEVICE=auto

# CNN Dropout Rate (must match trained model)
CNN_DROPOUT=0.3

# Ensemble Target Recall
TARGET_RECALL=0.80

# Data Settings
# =============================================================================

# Data split ratio (0.9 = 90% training, 10% testing)
TRAIN_SPLIT=0.9

# Temporal feature parameters
LAG_DAYS=3
ROLLING_WINDOW=7

# Frontend Settings (React SPA — Streamlit retired TAHAP E 2026-07-30)
# =============================================================================

# React dev server port (vite dev only): frontend served on 7860 in prod via start_api.py
REACT_DEV_PORT=3000

# Enable Demo Mode (when true, uses synthetic data if APIs fail)
# SECURITY: Set to false in production to ensure real model predictions
ENABLE_DEMO_MODE=false

# API Settings (FastAPI)
# =============================================================================

# API Host
API_HOST=0.0.0.0

# API Port
API_PORT=8000

# API Key for protected endpoints (generate a secure random string; minimum 32 chars)
# SECURITY: do not commit a real key. Replace placeholder before running.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server rejects known placeholder values at startup (see src/auth.py).
API_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Enable CORS (set to false in production if not needed)
ENABLE_CORS=true

# Database (Optional - for future use)
# =============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/firecast

# Cache Settings
# =============================================================================

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Enable hexagon precomputation
ENABLE_HEX_PRECOMPUTE=true

# Observability (Audit rekomendasi "Sentry/OpenTelemetry")
# =============================================================================
# Both optional. Leave blank to run FireCast without an error-tracing backend;
# observability degrades to no-op (capture_exception / span call sites don't
# raise). Set them when wiring prod telemetry:
#   SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
#   SENTRY_SAMPLE_RATE=1.0   # fraction of requests instrumented
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_RELEASE=
APP_ENV=development
