# FireCast environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must never be committed.

# ── API ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Bind address for start_api.py / uvicorn.
HOST=0.0.0.0
PORT=7860
API_HOST=0.0.0.0
API_PORT=8000

# Required by every protected endpoint (X-API-Key): /predict, /predict/aoi,
# /api/models/*, /admin/*. The server rejects empty/placeholder values with
# HTTP 500. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Optional CORS allow-list (CSV). Same-origin SPA traffic needs no entry.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Models / data ──────────────────────────────────────────────────────
# auto | cpu | cuda. `auto` picks CUDA when available.
ML_DEVICE=auto
TRAIN_SPLIT=0.9
LAG_DAYS=3
ROLLING_WINDOW=7

# Optional SQLModel registry/prediction database. Defaults to
# data/firecast.db when unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/firecast

# ── Observability (optional, no-op when unset) ─────────────────────────
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_RELEASE=
